# Copy to .env and fill in. `npx prisma dev` prints a local Postgres URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/a_thousand_words?schema=public"

# Cloudflare R2 (milestone 2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Auth.js (milestone 3). Generate AUTH_SECRET with `openssl rand -base64 32`.
# Create a GitHub OAuth app with callback URL http://localhost:3000/api/auth/callback/github
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Needed for `next start` outside Vercel (next dev trusts localhost automatically).
# AUTH_TRUST_HOST=true
