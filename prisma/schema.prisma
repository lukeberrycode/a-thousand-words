// Prisma schema for A Thousand Words.
// See docs/architecture.md for the data model rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User, Account, Session and VerificationToken follow the shape the Auth.js
// Prisma adapter expects. See docs/adr/0007.
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  // When the site owner approved this account to upload and annotate. Null means pending:
  // new GitHub sign-ins start pending (see scripts/users.ts).
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  images        Image[]
  regions       Region[]
  annotations   Annotation[]
}

model Account {
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Image {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Object key in R2; the public URL is derived from it.
  storageKey  String       @unique
  // Intrinsic pixel size, recorded at upload.
  width       Int
  height      Int
  // Fingerprints for spotting duplicate uploads (ADR 0010): SHA-256 of the file, and a 64-bit
  // perceptual hash of how it looks. Null for images uploaded before they existed.
  sha256      String?
  phash       BigInt?
  createdAt   DateTime     @default(now())
  regions     Region[]
  collections CollectionImage[]

  @@index([createdAt])
  @@index([sha256])
}

// A themed row on the home page, such as a period or movement (ADR 0014).
// An image can belong to any number of collections.
model Collection {
  id        String            @id @default(cuid())
  // Stable key used by the seed, so re-running it updates rather than duplicates.
  slug      String            @unique
  name      String
  // One line shown under the row heading.
  blurb     String?
  // Rows appear on the home page in ascending order.
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  images    CollectionImage[]
}

// Membership of an image in a collection, with its place in the row.
model CollectionImage {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  imageId      String
  image        Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  // Images appear in a row in ascending order.
  position     Int        @default(0)

  @@id([collectionId, imageId])
  @@index([imageId])
}

// A box on an image. It holds one or more annotations, by any users (ADR 0011).
// Stored as fractions (0–1) of the image's width and height, so it stays aligned at any
// display size (ADR 0005).
model Region {
  id          String       @id @default(cuid())
  imageId     String
  image       Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  // Who drew the box. Only they can move it, and only while it holds no one else's annotations.
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  x           Float
  y           Float
  w           Float
  h           Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  annotations Annotation[]

  @@index([imageId])
}

// One user's text about a region. Each user has at most one annotation per region.
model Annotation {
  id           String   @id @default(cuid())
  regionId     String
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bodyMarkdown String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([regionId, authorId])
}
