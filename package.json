{
  "name": "a-thousand-words",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:users": "tsx scripts/users.ts",
    "worktree:setup": "tsx scripts/worktree.ts setup",
    "worktree:teardown": "tsx scripts/worktree.ts teardown",
    "test:system": "playwright test",
    "test:perf": "lhci autorun",
    "prod:migrate": "sh scripts/with-keepass-env.sh a-thousand-words-prod prisma migrate deploy",
    "prod:seed": "sh scripts/with-keepass-env.sh a-thousand-words-prod tsx prisma/seed.ts",
    "prod:users": "sh scripts/with-keepass-env.sh a-thousand-words-prod tsx scripts/users.ts",
    "preview:migrate": "sh scripts/with-keepass-env.sh a-thousand-words-preview prisma migrate deploy",
    "preview:seed": "sh scripts/with-keepass-env.sh a-thousand-words-preview tsx prisma/seed.ts"
  },
  "dependencies": {
    "@annotorious/react": "^3.9.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
